# Ape Chain JSON-RPC endpoint. Default is the official RPC.
# Alternatives: https://apechain.drpc.org, https://apechain.calderachain.xyz/http
RPC_URL=https://rpc.apechain.com

# SQLite database path (relative to repo root).
DB_PATH=pnl.db

# Directory with per-game config files.
CONFIG_DIR=config/games

# Block range window used by the indexer (halves on RPC error, grows on success).
INDEXER_WINDOW=2000

# Seconds between tail polls once caught up to head.
TAIL_INTERVAL=10
